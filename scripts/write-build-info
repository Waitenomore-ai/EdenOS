#!/usr/bin/env python3
"""Write build identity; no machine or user identifiers are collected."""
import datetime
import json
import os
from pathlib import Path
import re
import sys

commit = os.environ.get('EDEN_SOURCE_COMMIT', 'unknown')
if commit != 'unknown' and not re.fullmatch(r'[0-9a-f]{40}', commit):
    raise SystemExit('EDEN_SOURCE_COMMIT must be a full lowercase Git commit SHA')
destination = Path(sys.argv[1])
destination.parent.mkdir(parents=True, exist_ok=True)
destination.write_text(json.dumps({
    'version': '0.1-dev', 'commit': commit,
    'built_at': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'),
}, indent=2) + '\n', encoding='utf-8')
